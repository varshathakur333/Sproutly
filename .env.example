# Sproutly — .env.example
# Copy to .env and fill in values before running.

# Required
SECRET_KEY=your-secret-key-here-change-in-production

# Development settings (defaults shown)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default; set for PostgreSQL in production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@localhost:5432/sproutly

# Optional: USDA FoodData Central API key (for import_usda command)
# Get a free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=
